# Copy to fireplanner.env (same directory) and edit. Gitignored, chmod 600.
#
# Almost everything here is read by run_fireplanner.sh on every run, so an edit
# takes effect on the next one. The exception is the schedule block below: those
# two keys are read by install.sh and baked into the launchd job, so changing
# them means re-running install.sh.

# ---- broker ---------------------------------------------------------------
# 4001 Gateway live · 4002 Gateway paper · 7496 TWS live · 7497 TWS paper
IB_PORT=4001
IB_HOST=127.0.0.1

# ---- schedule -------------------------------------------------------------
# Comma-separated HH:MM in the Mac's LOCAL time. Read by install.sh and baked
# into the launchd job, so CHANGING THESE MEANS RE-RUNNING install.sh — launchd
# reads a schedule when the job loads, not when it runs.
#
# 07:00 is a pre-open read: it shows the previous session's complete close, so
# you decide before the bell. The cost is that between yesterday's close and
# this morning's run the page is one session behind — add 16:35 as a second run
# if you also want to see today's close on the same evening.
FIREPLANNER_TIMES="07:00"      # e.g. "07:00" or "07:00,16:35"
FIREPLANNER_DAYS="daily"       # daily | weekdays

# ---- model ----------------------------------------------------------------
FIREPLANNER_SYMBOLS="SPY"
FIREPLANNER_CORE=0.40          # permanent core allocation, never sold

# ---- output ---------------------------------------------------------------
FIREPLANNER_SINGLE=1           # 1 = one index.html · 0 = three linked files
# FIREPLANNER_OUT="$HOME/Sites/fireplanner"

# ---- publishing to your own domain ----------------------------------------
# Setting either of these turns redaction ON by default: the pages otherwise
# carry your net liquidation, positions and trade sizes, and a page published
# with those in it cannot be un-published.
#
# --- Netlify ---------------------------------------------------------------
# Needs the CLI once:  npm install -g netlify-cli
# Site ID:   Netlify → your site → Site configuration → General → Site ID
# Token:     Netlify → user avatar → User settings → Applications →
#            Personal access tokens → New access token
# FIREPLANNER_NETLIFY_SITE="00000000-1111-2222-3333-444444444444"
# NETLIFY_AUTH_TOKEN="nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# Only if the CLI is somewhere unusual — otherwise it is found automatically.
# FIREPLANNER_NETLIFY_BIN="/opt/homebrew/bin/netlify"

# --- rsync over SSH --------------------------------------------------------
# The usual case for a VPS or shared host. The trailing slash matters.
# FIREPLANNER_RSYNC_TARGET="me@myhost.com:/var/www/fireplanner/"

# --- anything else ---------------------------------------------------------
# The command receives the build directory as "$1".
# FIREPLANNER_PUBLISH_CMD='aws s3 sync "$1" s3://my-bucket/ --delete'
# FIREPLANNER_PUBLISH_CMD='npx --yes wrangler pages deploy "$1" --project-name fireplanner'
# FIREPLANNER_PUBLISH_CMD='rclone sync "$1" mydrive:fireplanner'

# Override redaction only if you understand what goes out. When a deploy target
# is set this defaults to 1; the runner logs a warning if you set it to 0.
# FIREPLANNER_REDACT=1
