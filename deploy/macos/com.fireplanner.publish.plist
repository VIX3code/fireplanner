<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Template. install.sh loads this, fills in the paths, the port and the
     schedule, and writes the result to ~/Library/LaunchAgents/. It is never
     loaded by launchd directly, so the placeholder paths below are only there
     to keep this file a valid plist. -->
<dict>
  <key>Label</key>
  <string>com.fireplanner.publish</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>run_fireplanner.sh</string>
  </array>

  <!-- Filled in by install.sh from FIREPLANNER_TIMES and FIREPLANNER_DAYS in
       fireplanner.env; empty here because this file is a template, never loaded
       directly. Times are the Mac's LOCAL time, which is what launchd uses.

       The default is 07:00 daily: a pre-open read, showing the previous
       session's complete close. Any time works — a run only ever sees the last
       *completed* daily bar, and a partial bar for a session still in progress
       is dropped rather than charted. What the time decides is how long the
       page lags the close that produced it. -->
  <key>StartCalendarInterval</key>
  <array/>

  <!-- launchd fires a missed StartCalendarInterval once on wake, so a sleeping
       Mac catches up rather than silently skipping the day. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>fireplanner.launchd.out</string>
  <key>StandardErrorPath</key>
  <string>fireplanner.launchd.err</string>

  <key>WorkingDirectory</key>
  <string>.</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a minimal PATH; spell it out. /opt/homebrew/bin is
         where Homebrew installs on Apple Silicon, and is where node and the
         netlify CLI live if you installed them that way — leaving it off is a
         "command not found" that only ever shows up in the log. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>IB_PORT</key>
    <string>__IBPORT__</string>
  </dict>

  <!-- One run at a time. A slow gateway must not stack up jobs. -->
  <key>AbandonProcessGroup</key>
  <false/>
</dict>
</plist>
