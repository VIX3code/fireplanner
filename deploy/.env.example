# Copy to deploy/.env and fill in. Never commit the filled version.

# --- IBKR credentials (used only by the ib-gateway container) ---
IB_USER=your_ibkr_username
IB_PASSWORD=your_ibkr_password
IB_MODE=paper            # paper | live  -- start with paper
IB_PORT=4004             # the gateway container's relay: 4004 paper, 4003 live
IB_CLIENT_ID=17
# "yes" blocks all orders at the gateway. Set "no" only when the Swing Desk
# should place orders (trading.enabled: true in config/config.yaml).
IB_READ_ONLY_API=yes

# --- what to publish ---
SYMBOLS=SPY
CORE=0.40
# Leave as --redact unless the site is unreachable by anyone but you.
# Empty string publishes balances, positions and trade sizes.
REDACT=--redact

# --- web ---
DOMAIN=signals.example.com
AUTH_USER=admin
# docker run --rm caddy:2-alpine caddy hash-password
AUTH_HASH=

# --- Telegram alerts (optional) ---
# 1. message @BotFather -> /newbot -> copy the token
# 2. message your bot once, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
# Leave blank to disable. Nothing is sent unless the decision changes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- the live Swing Desk (served at https://DOMAIN/desk/) ---
# A second lock behind the basic auth: open the page once as /desk/?token=<this>.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
FIREPLANNER_DASH_TOKEN=
# Optional: earnings dates from Financial Modeling Prep's free tier.
FMP_API_KEY=

TZ=America/New_York
